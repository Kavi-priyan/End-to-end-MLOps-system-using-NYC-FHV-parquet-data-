# --- Jupyter Notebooks ---
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# --- IDEs & Editors ---
.vscode/
.idea/
.DS_Store

# --- MLOps: Data & Large Files ---
# Ignore actual data files, but keep the directory structure if needed
data/*
!data/.gitkeep
*.parquet
*.csv
*.tsv
*.json
*.zip
*.gz

# --- MLOps: Models & Artifacts ---
# Model binaries should be tracked in MLflow or DVC, not Git
models/*
!models/.gitkeep
*.pkl
*.pickle
*.joblib
*.bin
*.h5
*.onnx

# --- MLflow ---
# Local MLflow runs and artifacts (track these on a remote server instead)
mlruns/
mlartifacts/
.trash/

# --- DVC (Data Version Control) ---
# DVC manages data, but we must ignore its internal cache/tmp
.dvc/cache
.dvc/tmp
.dvc/plots
.dvc/upstreams

# Note: We DO want to commit *.dvc files
# !*.dvc 

# --- Orchestration (Airflow / Prefect) ---
airflow.db
airflow.cfg
webserver_config.py
*.db
prefect.db

# --- Logs & Debugging ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

